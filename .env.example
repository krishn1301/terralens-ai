# Backend (FastAPI)
# Comma-separated extra browser origins allowed by CORS. Localhost dev origins are always allowed;
# wildcards are ignored. Production: the GitHub Pages origin.
TERRALENS_CORS_ORIGINS=https://hmkz0x00.github.io
# Port supplied by the hosting platform (Render injects PORT automatically).
PORT=8000

# Frontend (Vite, read at build time)
# Public HTTPS URL of the backend API, without a trailing slash.
VITE_API_URL=http://localhost:8000
# Sub-path the static site is served from. Use /terralens-ai/ for GitHub Pages, / elsewhere.
VITE_BASE_PATH=/

# Reserved for a future optional language adapter. Not read by the current code;
# retrieval and recommendations never depend on it.
OPENAI_API_KEY=
